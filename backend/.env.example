# Copy to backend/.env and adjust. Process environment variables take precedence.

# HTTP server. Managed hosts that route external traffic require HOST=0.0.0.0.
HOST=127.0.0.1
PORT=3001

# AI service
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TIMEOUT_MS=120000

# PostgreSQL. DATABASE_URL takes precedence over the individual DB_* values.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/smart_attendance
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=smart_attendance
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Recognition gallery. Defaults to <cwd>/data/enrollment when unset.
# ENROLLMENT_ROOT=/absolute/path/to/enrollment

# Timezone used to expand recurring timetable weekdays into class sessions.
APP_TIMEZONE=Asia/Kolkata
