# HTTP server. Defaults to 0.0.0.0, which managed hosts require to route external
# traffic. Set HOST=127.0.0.1 only to restrict the listener to your own machine.
# HOST=0.0.0.0
PORT=3001

# AI service. Local default is the process on this machine. On Render this MUST
# be the public URL of the AI web service (https://....onrender.com), never
# 127.0.0.1 or localhost.
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TIMEOUT_MS=120000

# PostgreSQL. DATABASE_URL takes precedence over the individual DB_* values.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/smart_attendance
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=smart_attendance
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Absolute path to the local enrollment gallery sent to the AI service.
# Defaults to backend/data/enrollment. Ignored when the AI service reads Supabase Storage.
# ENROLLMENT_ROOT=

# Timezone used to expand recurring timetable weekdays into class sessions.
APP_TIMEZONE=Asia/Kolkata

# TEMPORARY pipeline test only. Leave unset in normal production.
# Exact value "true" also lists the most recent ended class so a recording
# can be processed without waiting for the next timetable slot.
# Does not change timetable rows, thresholds, or verification.
# Unset this after the test.
# ALLOW_ENDED_SESSION_TEST=true
