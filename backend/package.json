{
  "name": "smart-attendance-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:import-data": "tsx src/db/import-data-cli.ts",
    "recognition:harness": "tsx src/dev/recognition-harness.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
