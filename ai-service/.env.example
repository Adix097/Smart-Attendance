# HTTP server. Defaults to 0.0.0.0, which managed hosts require to route external
# traffic. Set HOST=127.0.0.1 only to restrict the listener to your own machine.
# HOST=0.0.0.0
PORT=8000

# Recognition defaults. Individual inference requests may override thresholds.
# buffalo_sc (~16MB) fits Render free 512MiB; buffalo_l (~326MB) does not.
AI_MODEL_NAME=buffalo_sc
AI_PROVIDER=CPUExecutionProvider
AI_DET_SIZE=320
AI_MAX_DETECTION_SIDE=960
AI_SAMPLING_FPS=2.0
AI_ACCEPTANCE_THRESHOLD=0.45
AI_UNKNOWN_THRESHOLD=0.35
AI_IDENTITY_MARGIN_THRESHOLD=0.05
AI_MINIMUM_OBSERVATIONS=3
# Heavy packs (buffalo_l, etc.) are blocked automatically on Render.
# Locally they are allowed unless you set AI_ENFORCE_MEMORY_BUDGET=true.
# On a larger Render plan, set AI_ALLOW_HEAVY_MODELS=true to use buffalo_l.
# AI_ALLOW_HEAVY_MODELS=false
# AI_ENFORCE_MEMORY_BUDGET=true

# Exposes POST /v1/dev/recognition-test. Must stay false outside local testing.
AI_ENABLE_DEV_HARNESS=false

# Enrollment gallery source: "local" reads the enrollment_dir sent by the backend,
# "supabase" downloads the private Storage bucket into ENROLLMENT_CACHE_DIR.
ENROLLMENT_SOURCE=local

# Required only when ENROLLMENT_SOURCE=supabase. Server-side secrets; never ship to the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=enrollment

# Optional. Defaults to a "smart-attendance-enrollment" directory inside the system temp directory.
ENROLLMENT_CACHE_DIR=
